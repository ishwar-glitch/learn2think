---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../islands/ThemeToggle.tsx';
import Waitlist from '../islands/Waitlist.tsx';
const steps = [
  ['Try first', 'You attempt a small problem before anything is explained.'],
  ['See the idea', 'A short explanation, linked to what you just tried.'],
  ['Use it on a real case', 'Ask stakeholders, request data, write a recommendation, face a challenge.'],
  ['Keep the evidence', 'Each case leaves a Thinking Record in your portfolio.'],
];
---
<Base title="Learn2Think: practise how you think" description="Real business problems, small steps, and feedback on your reasoning. Join the waitlist.">
  <header class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
    <div class="flex items-center gap-2">
      <img src="/brand/app-icon-chatgpt-v1.svg" alt="" width="32" height="32" />
      <span class="font-semibold">Learn2Think</span>
    </div>
    <div class="flex items-center gap-4">
      <a href="/signin" class="underline underline-offset-4">Sign in</a>
      <ThemeToggle client:load />
    </div>
  </header>
  <main class="mx-auto max-w-4xl space-y-8 px-4 pb-16">
    <section class="rounded-2xl bg-hero p-6 sm:p-10">
      <p class="text-sm text-ink-2">For students and career switchers · BA · DA · PM · PD</p>
      <h1 class="mt-2 max-w-[680px] text-[28px] font-semibold leading-tight sm:text-5xl">Practise how you think, not what you memorised.</h1>
      <p class="mt-4 max-w-[680px] text-ink-2">Real business problems, small steps, and feedback on your reasoning. Build a portfolio that shows how you think.</p>
      <a href="#waitlist" class="mt-6 inline-block rounded-full bg-accent px-6 py-3 font-semibold text-on-accent">Join the waitlist</a>
      <p class="mt-2 text-sm text-ink-2">The first case is on its way. Join to hear when it is ready.</p>
    </section>

    <section aria-labelledby="how">
      <h2 id="how" class="text-xl font-medium">How a session works</h2>
      <ol class="mt-4 grid gap-3 sm:grid-cols-2">
        {steps.map(([t, d], i) => (
          <li class="rounded-xl border border-line bg-surface p-4">
            <span class="text-sm text-ink-3">Step {i + 1}</span>
            <h3 class="font-medium">{t}</h3>
            <p class="text-ink-2">{d}</p>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="who">
      <h2 id="who" class="text-xl font-medium">Who it is for</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <div class="rounded-xl border border-line bg-surface p-4"><h3 class="font-medium">Students</h3><p class="text-ink-2">Practise reasoning on real problems before your first role.</p></div>
        <div class="rounded-xl border border-line bg-surface p-4"><h3 class="font-medium">Career switchers</h3><p class="text-ink-2">Turn the experience you already have into clear, evidenced thinking.</p></div>
      </div>
      <p class="mt-3 text-ink-2">Roles: Business analysis · Data analysis · Product management · Product design</p>
    </section>

    <section id="waitlist" aria-labelledby="wl" class="relative max-w-xl rounded-2xl border border-line bg-surface p-6">
      <h2 id="wl" class="text-xl font-medium">Join the waitlist</h2>
      <p class="mb-4 mt-1 text-ink-2">We will email you once, when the first case is ready. Founding members (first 500) get a year at ₹1,499 with a code.</p>
      <Waitlist client:load />
      <p class="mt-4 text-sm text-ink-3">We use your email only to tell you when Learn2Think opens. We do not sell it. Read the <a href="/privacy" class="underline">privacy notice</a>.</p>
    </section>
  </main>
  <footer class="mx-auto max-w-4xl px-4 pb-8 text-sm text-ink-3"><a href="/privacy" class="underline">Privacy</a></footer>
</Base>
