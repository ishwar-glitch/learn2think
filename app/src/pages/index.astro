---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../islands/ThemeToggle.tsx';
import { getCollection } from 'astro:content';
const universe = await getCollection('universe');
---
<Base title="Learn2Think">
  <header class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
    <div class="flex items-center gap-2">
      <img src="/brand/app-icon-chatgpt-v1.svg" alt="" width="32" height="32" />
      <span class="font-semibold">Learn2Think</span>
    </div>
    <ThemeToggle client:load />
  </header>
  <main class="mx-auto max-w-4xl space-y-6 px-4 pb-16">
    <section class="rounded-2xl bg-hero p-6 sm:p-10">
      <h1 class="max-w-[680px] text-[28px] font-semibold leading-tight sm:text-5xl">Learn to think like the person who makes the call.</h1>
      <p class="mt-4 max-w-[680px] text-ink-2">Practice real business decisions, one case at a time. Early build: the full product is coming.</p>
      <a href="/signin" class="mt-6 inline-block rounded-full bg-accent px-6 py-3 font-semibold text-on-accent">Sign in</a>
    </section>
    <section class="rounded-xl border border-line bg-surface p-5">
      <h2 class="text-xl font-medium">Content check</h2>
      <p class="mt-1 text-ink-2">{universe.length} company profiles loaded from <code>../content</code>.</p>
    </section>
  </main>
</Base>
